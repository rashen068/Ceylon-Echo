rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'profileImage', 'interests', 'createdAt', 'role'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.profileImage == null
          || request.resource.data.profileImage is string)
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 30
        && request.resource.data.createdAt == request.time
        && request.resource.data.role == 'user';
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'profileImage', 'interests'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email == resource.data.email
        && (request.resource.data.profileImage == null
          || request.resource.data.profileImage is string)
        && request.resource.data.interests is list
        && request.resource.data.interests.size() <= 30;
      allow delete: if false;

      match /savedAttractions/{attractionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['attractionId', 'savedAt'])
          && request.resource.data.attractionId == attractionId
          && request.resource.data.savedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }

    match /attractions/{attractionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get, list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'attractionId', 'attractionName', 'bookingDate',
          'numberOfPeople', 'totalPrice', 'status', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.attractionId is string
        && request.resource.data.attractionName is string
        && request.resource.data.bookingDate is timestamp
        && request.resource.data.numberOfPeople is int
        && request.resource.data.numberOfPeople > 0
        && request.resource.data.numberOfPeople <= 20
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'attractionId', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.attractionId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'attractionId', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.attractionId == resource.data.attractionId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
