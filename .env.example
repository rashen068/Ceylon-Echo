# Copy these client configuration values from Firebase Project settings > General > Your apps.
# They are public app identifiers, not credentials for administrative access.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Optional: only needed to manage existing Firebase Storage media.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Maps SDK keys used at native build time; restrict each key to this app's ID
# and its corresponding Maps SDK in Google Cloud Console.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Browser key for the Google Maps JavaScript API; restrict it to your web origins.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
